{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchyard Desktop",
  "version": "0.1.0",
  "identifier": "dev.switchyard.desktop.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Switchyard Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#080A0A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "runtime/": "runtime/",
      "../licenses/": "licenses/",
      "../resources/": "notices/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
