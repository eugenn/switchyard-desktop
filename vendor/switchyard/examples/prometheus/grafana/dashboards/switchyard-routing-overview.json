{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Routing health, latency attribution, failure detail, and token cost for a Switchyard deployment. Every rate and quantile is computed over the Rate window variable; widen it on a low-traffic deployment.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "external link",
      "includeTimeRange": true,
      "keepTime": true,
      "targetBlank": true,
      "title": "Tempo trace explorer",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22switchyard-tempo%22%7D"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Share of LLM-route responses returned to clients as an error (retryable_error + other_error). This is what callers actually experienced, after the router's retries and failovers. Blank means no traffic in the window.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(switchyard_client_responses_total{outcome=~\"retryable_error|other_error\"}[$window]))\n  / sum(rate(switchyard_client_responses_total[$window]))",
          "legendFormat": "Client error rate",
          "refId": "A"
        }
      ],
      "title": "Client Error Rate ($window)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Headline success criterion: upstream retryable-error rate minus the retryable-error rate clients saw. Positive means the router absorbed failures that a direct connection would have surfaced. Zero or negative means it is not adding value.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(switchyard_upstream_attempts_total{outcome=\"retryable_error\"}[$window]))\n    / sum(rate(switchyard_upstream_attempts_total[$window]))\n  -\nsum(rate(switchyard_client_responses_total{outcome=\"retryable_error\"}[$window]))\n    / sum(rate(switchyard_client_responses_total[$window]))",
          "legendFormat": "Error rate reduction",
          "refId": "A"
        }
      ],
      "title": "Retryable Error Reduction ($window)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Throughput on the LLM-serving routes (/v1/chat/completions, /v1/messages, /v1/responses), counting every response regardless of outcome.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(switchyard_client_responses_total[$window]))",
          "legendFormat": "Responses/s",
          "refId": "A"
        }
      ],
      "title": "Client Responses/s ($window)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Algorithm runs started and not yet finished. Stuck above zero with no traffic means runs are parked on a classifier or judge call that never returns.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(switchyard_algorithms_in_flight)",
          "legendFormat": "In-flight",
          "refId": "A"
        }
      ],
      "title": "Routing Runs In Flight",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Upstream operations that failed at least once and then succeeded. Each one is a client error the router prevented.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(switchyard_router_retry_recovered_total[$window]))",
          "legendFormat": "Recovered",
          "refId": "A"
        }
      ],
      "title": "Retries Recovered ($window)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Judge failures that forced a classifier to route without a verdict. The client request can still succeed on the fallback target, but the routing decision was lost. Break down by judge_model and reason on /metrics.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(switchyard_classifier_fail_open_total[$window]))",
          "legendFormat": "Fail-open",
          "refId": "A"
        }
      ],
      "title": "Classifier Fail-Open ($window)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Full-turn latency for successful routed responses, as a moving-window quantile. For streaming responses this is total turn time, not time-to-first-token. Gaps mean no successful response landed in the window.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(switchyard_total_latency_ms_bucket{model=~\"$model\"}[$window])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(switchyard_total_latency_ms_bucket{model=~\"$model\"}[$window])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(switchyard_total_latency_ms_bucket{model=~\"$model\"}[$window])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "End-to-End Latency ($window window)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Time spent deciding where to send the request: classifier and judge calls, target resolution, failed attempts, decision publication. Log scale, because a passthrough algorithm lands under a millisecond while a classifier-backed one spends a whole LLM call here. Compare p99 against End-to-End Latency to see what routing costs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "scaleDistribution": {
              "log": 10,
              "type": "log"
            },
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (algorithm, le) (rate(switchyard_routing_overhead_ms_bucket{algorithm=~\"$algorithm\"}[$window])))",
          "legendFormat": "p50 {{algorithm}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (algorithm, le) (rate(switchyard_routing_overhead_ms_bucket{algorithm=~\"$algorithm\"}[$window])))",
          "legendFormat": "p99 {{algorithm}}",
          "refId": "B"
        }
      ],
      "title": "Routing Overhead by Algorithm ($window window)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Successful routed model calls per second, stacked by the endpoint that served them. This is the routing decision as it actually played out, including failover. The dashed series is failed routed calls across all endpoints.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed calls"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "group": "B",
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    4
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (model) (rate(switchyard_requests_total{model=~\"$model\"}[$window]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(switchyard_errors_total{model=~\"$model\"}[$window]))",
          "legendFormat": "failed calls",
          "refId": "B"
        }
      ],
      "title": "Served Request Rate by Endpoint ($window)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Latency of the terminal model call per endpoint, excluding routing overhead. Use it to tell a slow upstream apart from slow routing: if this is flat while End-to-End Latency climbs, the cost is in the router, not the model.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (model, le) (rate(switchyard_model_call_latency_ms_bucket{model=~\"$model\"}[$window])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (model, le) (rate(switchyard_model_call_latency_ms_bucket{model=~\"$model\"}[$window])))",
          "legendFormat": "p99 {{model}}",
          "refId": "B"
        }
      ],
      "title": "Model Call Latency by Endpoint ($window window)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Composition of what clients received. ok is HTTP 2xx; retryable_error is 408, 429, any 5xx, or a failure before a status line; other_error is everything else (400, 401, 403, 422). client_disconnected means the caller went away before a response was written.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retryable_error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other_error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client_disconnected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(switchyard_client_responses_total[$window]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Client Responses by Outcome ($window)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prometheus"
      },
      "description": "Individual upstream attempts that did not succeed, by raw HTTP status. One client request can produce several attempts through retry, so this runs higher than the client error rate \u2014 that gap is the router doing its job. code=none is a failure with no status line (network error, reset, pre-status timeout).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineInterpolation": "smooth",
            "lineWidth": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
